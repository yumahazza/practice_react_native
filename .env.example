# ========================================================
# PANDUAN KONFIGURASI FIREBASE & GOOGLE AUTHENTICATION
# Salin file ini menjadi .env jika ingin menggunakan kredensial Firebase asli
# ========================================================

# Firebase Web App Credentials (Didapat dari Firebase Console > Project Settings > General)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nama-project-anda.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nama-project-anda
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nama-project-anda.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Google OAuth Client ID (Didapat dari Google Cloud Console / Firebase Authentication > Sign-in method > Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
